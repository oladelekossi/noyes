{
  "name": "noyes",
  "version": "0.2.2",
  "description": "Fine-tune your X feed with keyboard shortcuts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oladelekossi/noyes.git"
  },
  "homepage": "https://github.com/oladelekossi/noyes#readme",
  "bugs": {
    "url": "https://github.com/oladelekossi/noyes/issues"
  },
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:scripts": "node --test scripts/layers.test.mjs scripts/probe-live.test.mjs",
    "check": "node scripts/layers.mjs",
    "package": "node scripts/package.mjs",
    "format": "prettier --write \"extension/*.{js,css,json}\" \"scripts/*.mjs\" \"tests/*.{js,mjs}\" \"tests/unit/*.mjs\" playwright.config.mjs",
    "probe:live": "node scripts/probe-live.mjs",
    "debug:build": "node scripts/build-debug.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
