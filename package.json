{
  "name": "noyes",
  "version": "0.2.2",
  "description": "Fine-tune your X feed from your keyboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oladelekossi/noyes.git"
  },
  "homepage": "https://github.com/oladelekossi/noyes#readme",
  "bugs": {
    "url": "https://github.com/oladelekossi/noyes/issues"
  },
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "check": "npm run vet && node scripts/layers.mjs",
    "package": "node scripts/package.mjs",
    "vet": "node scripts/vet.mjs",
    "vet:all": "node scripts/vet.mjs --json",
    "format": "prettier --write \"extension/*.{js,css,json}\" \"scripts/*.mjs\" \"tests/*.{js,mjs}\" \"tests/unit/*.mjs\" playwright.config.mjs",
    "test:vet": "node --test scripts/vet.test.mjs scripts/layers.test.mjs scripts/probe-live.test.mjs",
    "probe:live": "node scripts/probe-live.mjs",
    "debug:build": "node scripts/build-debug.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vet/typescript": "file:vendor/vet-typescript-8aae498.tgz"
  }
}
