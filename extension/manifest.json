{
  "manifest_version": 3,
  "name": "wheel",
  "version": "0.1.0",
  "description": "A small Not interested button for your X feed.",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
