{
  "manifest_version": 3,
  "name": "wheel",
  "version": "0.2.0",
  "description": "Tune your X feed with j/k navigation, l to like, and n for Not interested, and u to undo feedback.",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "x.js",
        "ui.js",
        "feed.js",
        "selection.js",
        "feedback.js",
        "input.js",
        "main.js"
      ],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
